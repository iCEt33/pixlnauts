{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/upload.mjs": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/b-b0-customizer/models/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)\\.php", "destination": "/api/trap" },
    { "source": "/(.*)wp-(admin|includes|content|json)(.*)", "destination": "/api/trap" },
    { "source": "/(.*)\\.env(.*)", "destination": "/api/trap" },
    { "source": "/(.*)\\.git/(.*)", "destination": "/api/trap" },
    { "source": "/(.*)\\.aws/(.*)", "destination": "/api/trap" },
    { "source": "/(.*)phpmyadmin(.*)", "destination": "/api/trap" },
    { "source": "/cgi-bin/(.*)", "destination": "/api/trap" }
  ]
}
